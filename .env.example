# Kopiera den här filen till .env och fyll i dina egna värden.
# .env innehåller dina hemliga nycklar – dela den aldrig med någon.

# --- Telegram (larm med bild och knappar) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- ntfy (enkel push-notis) ---
NTFY_TOPIC=

# --- Twilio (ringer dig vid larm) ---
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
CALL_TO=

# --- Valfritt ---
# ANTHROPIC_API_KEY=        # använd Claude som språk-AI i stället för Ollama
# ANHORIG_NAMN=Olle         # namnet som sägs när du svarar i Telegram
# EDGE_VOICE=sv-SE-MattiasNeural
# ALWAYS_LISTEN=0          # sluta lyssna efter rop på hjälp
# INACTIVITY_CHECK=0       # stäng av inaktivitetskollen
# CHECKUP_TIMES=10:00,16:00 # dagliga koller
